# ───────── Database ─────────
DATABASE_URL="postgresql://evam:evam@localhost:5433/evam_assets?schema=public"

# ───────── Auth.js ─────────
# Generate with: `openssl rand -base64 32`
AUTH_SECRET="change-me-to-32-byte-random"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Disable open registration in production (admins create users from Settings)
AUTH_ALLOW_SIGNUP="false"

# ───────── Email (Magic Link + alerts) ─────────
# Prod: Resend; local: MailHog SMTP via nodemailer
RESEND_API_KEY=""
EMAIL_FROM="Evam Assets <no-reply@evam.com>"
EMAIL_SMTP_HOST="localhost"
EMAIL_SMTP_PORT="1025"

# ───────── Storage (asset photos, floor plans) ─────────
UPLOADTHING_TOKEN=""

# ───────── AI (auto-categorization) ─────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ───────── Misc ─────────
NODE_ENV="development"
