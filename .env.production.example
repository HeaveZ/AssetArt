# ─────────────────────────────────────────────────────────────────────────────
# AssetArt production secrets — copy to `.env.production` on the server and
# fill in real values. NEVER commit the populated file. Generate AUTH_SECRET with:
#   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (read by docker-compose.prod.yml and the app)
POSTGRES_USER=assetart
POSTGRES_PASSWORD=please-change-me-strong-password
POSTGRES_DB=assetart

# Auth.js
AUTH_SECRET=replace-with-32-byte-base64-secret
AUTH_URL=https://assets.yourdomain.com
NEXT_PUBLIC_APP_URL=https://assets.yourdomain.com
AUTH_ALLOW_SIGNUP=false

# Email (production: Resend; for SMTP fallback fill EMAIL_SMTP_*)
RESEND_API_KEY=
EMAIL_FROM=AssetArt <no-reply@yourdomain.com>
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=

# Storage
UPLOADTHING_TOKEN=

# AI (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# App
APP_PORT=3000
NODE_ENV=production
